# Supabase (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail SMTP (https://myaccount.google.com/apppasswords)
# Requires 2-Step Verification enabled + an App Password (16 chars, no spaces)
GMAIL_USER=ui30days@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM="30Days Game UI <ui30days@gmail.com>"

# Public URL of your site (used in emails and links)
PUBLIC_URL=https://your-site.com

# Secret used to protect /api/cron (pick a long random string)
CRON_SECRET=change-me-to-a-long-random-string
