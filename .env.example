# Supabase (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Brevo API (https://app.brevo.com → Settings → API Keys)
# Transactional key, format xkeysib-...
BREVO_API_KEY=xkeysib-your-key
# Sender email verified in Brevo (Settings → Senders)
EMAIL_FROM="30Days Game UI <ui30days@gmail.com>"

# Public URL of your site (used in emails and links)
PUBLIC_URL=https://your-site.com

# Secret used to protect /api/cron (pick a long random string)
CRON_SECRET=change-me-to-a-long-random-string
